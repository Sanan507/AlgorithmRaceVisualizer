# ==============================================================================
# AlgoRace - Environment Variables Configuration Template
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Port configuration
FRONTEND_PORT=3000
BACKEND_PORT=8080

# API Connection Base URL
# - For Docker with Nginx reverse proxy: leave EMPTY ("") so requests route to /api
# - For separate external backend host: specify full URL (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=

# Backend CORS Allowed Origins (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Backend JVM Memory Options
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m

